---
import { render } from "astro:content";
import { getBookChapters, getChapterNav } from "@lib/book";
import BookLayout from "@layouts/BookLayout.astro";

export async function getStaticPaths() {
  const chapters = await getBookChapters();
  return chapters.map((chapter) => ({ params: { id: chapter.entry.id } }));
}

const { id } = Astro.params;
const { current, prev, next } = await getChapterNav(id!);
const { Content, headings } = await render(current.entry);

const sections = headings.filter((heading) => heading.depth === 2);
---

<BookLayout title={current.entry.data.title} description={current.entry.data.description}>
  <article class="mx-auto max-w-2xl px-6 py-16">
    <header>
      <p class="flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-slate-500">
        <a href="/book" class="hover:text-mauve-700">{current.partTitle}</a>
        <span class="text-slate-300">/</span>
        <span class="text-slate-400">Chapter {current.number}</span>
      </p>
      <h1 class="mt-3 text-pretty text-4xl font-bold tracking-tight text-mauve-900">
        {current.entry.data.title}
      </h1>
      <p class="mt-4 text-lg text-pretty text-slate-500">{current.entry.data.description}</p>
    </header>

    {
      sections.length > 1 && (
        <nav
          aria-label="On this page"
          class="mt-12 overflow-hidden rounded-xl bg-mauve-100/50"
        >
          <div class="border-l-4 border-mauve-300 px-6 py-5">
            <p class="text-sm font-semibold tracking-tight text-mauve-800">On this page</p>
            <ol class="mt-4 space-y-2.5 text-sm">
              {sections.map((heading, index) => (
                <li class="flex gap-3">
                  <span class="w-4 shrink-0 pt-px text-right text-xs font-medium tabular-nums text-mauve-400">
                    {index + 1}
                  </span>
                  <a
                    href={`#${heading.slug}`}
                    class="font-medium text-mauve-800 transition-colors hover:text-mauve-600"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
      )
    }

    <div class="prose prose-slate mt-12 max-w-none">
      <Content />
    </div>

    <nav class="mt-20 grid grid-cols-2 gap-6 border-t border-slate-200 pt-8 text-sm">
      <div>
        {
          prev && (
            <a href={prev.href} class="group block">
              <span class="text-xs uppercase tracking-widest text-slate-400">Previous</span>
              <span class="mt-1 block text-slate-700 group-hover:text-mauve-700">
                {prev.number}. {prev.entry.data.title}
              </span>
            </a>
          )
        }
      </div>
      <div class="text-right">
        {
          next && (
            <a href={next.href} class="group block">
              <span class="text-xs uppercase tracking-widest text-slate-400">Next</span>
              <span class="mt-1 block text-slate-700 group-hover:text-mauve-700">
                {next.number}. {next.entry.data.title}
              </span>
            </a>
          )
        }
      </div>
    </nav>
  </article>
</BookLayout>
